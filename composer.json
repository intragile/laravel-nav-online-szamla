{
    "name": "intragile/laravel-nav-online-szamla",
    "description": "Complete, Laravel-native client for the Hungarian NAV Online Számla (Online Invoice) v3.0 API.",
    "keywords": [
        "laravel",
        "nav",
        "online-szamla",
        "online-invoice",
        "hungary",
        "e-invoice",
        "szamla"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "IntrAgile Kft.",
            "email": "info@intragile.hu"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "IntrAgile\\NavOnlineSzamla\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IntrAgile\\NavOnlineSzamla\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "generate-model": "php bin/generate-model.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "IntrAgile\\NavOnlineSzamla\\NavOnlineSzamlaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
